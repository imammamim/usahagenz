    .pin-input { font-size: 16px; font-weight: 700; letter-spacing: 0.28em; text-align: center; height: 42px; }
    .info-callout { background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; font-size: 13px; color: var(--text-secondary); }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .ai-chips { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 12px; }
    .ai-chip {
      padding: 7px 12px; border-radius: 9px; border: 1px solid var(--border); background: var(--bg-subtle);
      color: var(--text-secondary); font: 600 12.5px inherit; cursor: pointer; text-align: left;
    }
    .ai-chip:hover { background: var(--accent-soft); color: var(--accent-text); border-color: var(--hadir-border); }
    .ai-chat-box {
      display: flex; flex-direction: column; gap: 10px; max-height: 360px; overflow-y: auto;
      padding: 12px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 12px;
    }
    .ai-msg { padding: 11px 14px; border-radius: 11px; font-size: 13.5px; line-height: 1.55; }
    .ai-msg.bot { background: var(--bg-card); border: 1px solid var(--border); color: var(--text-primary); }
    .ai-msg.user { background: #10231b; color: #f2f8f5; margin-left: 24px; border: 1px solid #284d3d; }
    .ai-form { display: flex; gap: 8px; margin-top: 12px; }
    .reminder-item { padding: 12px 15px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .reminder-item:last-child { border-bottom: none; }

    /* RECEIPT */
    .rcpt-banner { background: var(--hadir-bg); border: 1px solid var(--hadir-border); color: var(--hadir-text); padding: 9px 12px; border-radius: 9px; text-align: center; font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .rcpt-total-box { background: #10231b; color: #f2f8f5; border: 1px solid #284d3d; border-radius: 12px; padding: 15px 16px; display: flex; flex-direction: column; gap: 8px; }
    .rcpt-row { display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #96b3a3; }
    .rcpt-row strong { color: #ffffff; font-size: 14.5px; }
    .rcpt-grand { border-top: 1px solid #284d3d; padding-top: 10px; margin-top: 2px; display: flex; justify-content: space-between; align-items: center; }

    /* MODALS & TOAST */
    .backdrop { position: fixed; inset: 0; background: rgba(10, 22, 16, 0.56); backdrop-filter: blur(2px); display: none; align-items: center; justify-content: center; z-index: 50; padding: 16px; }
    .backdrop.show { display: flex; }
    .modal-box { background: var(--bg-card); border: 1px solid var(--border); border-radius: 18px; width: 100%; max-width: 480px; box-shadow: var(--shadow-modal); overflow: hidden; }
    .modal-head { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .modal-title { font-size: 16px; font-weight: 700; }
    .close-btn { background: none; border: none; color: var(--text-muted); font-size: 24px; cursor: pointer; line-height: 1; padding: 2px 6px; }
    .modal-body { padding: 18px 20px; display: flex; flex-direction: column; gap: 13px; max-height: 82dvh; overflow-y: auto; }
    .modal-foot { padding: 14px 20px; border-top: 1px solid var(--border); background: var(--bg-subtle); display: flex; justify-content: flex-end; gap: 8px; }

    .form-item { display: flex; flex-direction: column; gap: 6px; }
    .form-item label { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
    .info-line { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 13.5px; gap: 12px; }
    .info-line:last-child { border-bottom: none; }
    .detail-hero { display: flex; align-items: center; gap: 12px; padding: 13px 14px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 12px; }
    .detail-avatar-lg {
      width: 48px; height: 48px; border-radius: 12px; background: #10231b; border: 1.5px solid var(--accent); color: #34d399;
      font-size: 16px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }

    .toast {
      position: fixed; top: calc(14px + env(safe-area-inset-top)); left: 50%; transform: translate(-50%, -18px);
      background: rgba(16, 35, 27, 0.96); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      color: #f2f8f5; border: 1px solid #284d3d; padding: 10px 18px; border-radius: 999px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28); opacity: 0; pointer-events: none;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); z-index: 95;
      display: flex; align-items: center; gap: 10px; max-width: calc(100vw - 24px);
    }
    .toast.show { opacity: 1; transform: translate(-50%, 0); }
    .toast-dot { width: 8px; height: 8px; border-radius: 50%; background: #34d399; flex-shrink: 0; }

    .empty-msg { text-align: center; padding: 32px 16px; color: var(--text-muted); font-size: 13.5px; }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(10, 22, 16, 0.55); z-index: 30; }
    .sidebar-overlay.show { display: block; }

    .mobile-bottom-nav {
      display: none; position: fixed; left: 12px; right: 12px; bottom: calc(10px + env(safe-area-inset-bottom));
      background: rgba(16, 35, 27, 0.94); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(52, 211, 153, 0.24); border-radius: 22px; padding: 6px 8px;
      z-index: 28; justify-content: space-around; align-items: center; box-shadow: 0 14px 32px rgba(6, 18, 12, 0.42);
    }
    .mb-nav-btn {
      background: none; border: none; color: var(--sb-muted); font: 600 10.5px inherit;
      display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 5px 8px; cursor: pointer; flex: 1;
    }
    .mb-nav-btn.active { color: var(--sb-emerald); }
    .mb-fab-btn {
      width: 44px; height: 44px; border-radius: 15px; border: none; background: linear-gradient(135deg, #34d399, #10b981);
      color: #06140e; display: flex; align-items: center; justify-content: center; cursor: pointer;
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.42); flex-shrink: 0; margin: 0 4px;
    }

    @media (max-width: 1180px) {
      .kpi-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .kpi-grid .kpi-card:first-child { grid-column: span 4; }
      .kpi-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .split-layout, .admin-layout, .kpi-grid-3 { grid-template-columns: 1fr; }
    }
    @media (max-width: 1024px) {
