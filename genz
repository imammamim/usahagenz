    function filterStatus(status) {
      currentStatusFilter = status;
      updateFilterPillsUI();
      applyFilters();
    }

    function updateFilterPillsUI() {
      ['ALL', 'Jatuh Tempo', 'Aman', 'Lunas'].forEach(s => {
        if ($(`pill-${s}`)) $(`pill-${s}`).classList.toggle('active', currentStatusFilter === s);
      });
    }

    function applyFilters() {
      const query = ($('searchInput').value || '').toLowerCase().trim();
      const filtered = currentMonthData.filter(item => {
        const matchQuery = !query || item.nama.toLowerCase().includes(query) || String(item.catatan || '').toLowerCase().includes(query) || item.bulan.toLowerCase().includes(query);
        const c = classifyLoanItem_(item);
        if (currentStatusFilter === 'Jatuh Tempo') return matchQuery && c.isOverdue;
        if (currentStatusFilter === 'Aman') return matchQuery && !c.isOverdue && !c.isPaid;
        if (currentStatusFilter === 'Lunas') return matchQuery && c.isPaid;
        return matchQuery;
      });
      renderLoansView(filtered);
    }

    function getInitials(name) {
      const p = String(name || '?').trim().split(/\s+/);
      return p.length === 1 ? p[0].substring(0, 2).toUpperCase() : (p[0][0] + p[1][0]).toUpperCase();
    }

    function renderLoansView(dataArray) {
      const tbody = $('loanTableBody');
      const tfoot = $('loanTableFoot');
      const mobileList = $('mobileLoanList');
      tbody.innerHTML = '';
      tfoot.innerHTML = '';
      if (mobileList) mobileList.innerHTML = '';

      if (!dataArray || !dataArray.length) {
        tbody.innerHTML = '<tr><td colspan="11" class="empty-msg">Tidak ada data peminjam yang sesuai filter.</td></tr>';
