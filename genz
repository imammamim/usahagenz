      .header-left, .header-controls { width: 100%; }
      .page-title { font-size: 17px; }
      .page-subtitle { font-size: 12px; }
      .header-controls { justify-content: space-between; gap: 7px; }
      .header-controls .field, .header-controls .btn { flex: 1; height: 38px; font-size: 13px; padding: 0 10px; }
      .workspace-body { padding: 14px 12px calc(94px + env(safe-area-inset-bottom)); }
      .kpi-grid, .kpi-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 16px; }
      .kpi-grid .kpi-card:first-child { grid-column: span 2; }
      .kpi-card { padding: 14px; border-radius: 15px; }
      .kpi-label { font-size: 12px; }
      .kpi-num { font-size: 18.5px; }
      .kpi-grid .kpi-card:first-child .kpi-num { font-size: 24px; }
      .mini-pills { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; }
      .desktop-table-wrap { display: none; }
      .mobile-loan-list { display: flex; }
      .panel-head { padding: 13px 14px; }
      .panel-title { font-size: 15px; }
      .segment-group { width: 100%; overflow-x: auto; scrollbar-width: none; padding: 4px; }
      .segment-group::-webkit-scrollbar { display: none; }
      .segment-btn { padding: 7px 12px; font-size: 12.5px; }
      .search-box, .search-input { width: 100%; min-width: 0; }
      .grid-2 { grid-template-columns: 1fr; }
      .field, input, select, textarea { font-size: 16px !important; height: 42px; }
      .btn-xs { font-size: 12.5px !important; height: 34px; }
      .backdrop { padding: 0; align-items: flex-end; }
      .modal-box { max-width: 100%; border-radius: 22px 22px 0 0; border-bottom: none; }
      .modal-body { max-height: 82dvh; padding: 16px; }
      .modal-foot { padding: 12px 16px calc(14px + env(safe-area-inset-bottom)); }
      .modal-foot .btn { flex: 1; height: 42px; }
    }

    .print-table-header { display: none; }
    @media print {
      @page { size: landscape; margin: 10mm; }
      body, .app-shell, .main-area, .workspace-body, .panel, .table-scroll, .desktop-table-wrap {
        background: #fff !important; background-image: none !important; color: #000 !important; margin: 0 !important; padding: 0 !important;
        overflow: visible !important; max-height: none !important; box-shadow: none !important; border: none !important; display: block !important;
      }
      .sidebar, .workspace-header, .mobile-bottom-nav, .mobile-loan-list, .urgent-banner, .no-print, .kpi-grid, #chartPanel, #section-keuntungan, #section-ai, #section-admin, .toast, .pin-gate { display: none !important; }
      .print-table-header { display: block !important; margin-bottom: 14px; padding-bottom: 8px; border-bottom: 2px solid #112218; }
      table { width: 100% !important; border-collapse: collapse !important; }
      th, td { border: 1px solid #cbd5e1 !important; padding: 7px 10px !important; color: #000 !important; font-size: 9pt !important; position: static !important; }
      th { background: #f1f5f9 !important; }
    }
  </style>
