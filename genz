      let sumPinjaman = 0, sumFee = 0;
      dataArray.forEach((item, idx) => {
        const c = classifyLoanItem_(item);
        sumPinjaman += c.pinjaman;
        sumFee += c.fee15;

        const safeNama = escapeHTML(item.nama);
        const safeCatatan = escapeHTML(item.catatan);
        const statusBadge = c.isPaid
          ? '<span class="badge badge-hadir"><span class="st-dot"></span>Lunas</span>'
