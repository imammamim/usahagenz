            : `<span class="badge badge-izin"><span class="st-dot"></span>${escapeHTML(item.sisa)}</span>`);

        const riskBadge = c.isOverdue
          ? '<span class="badge badge-sakit">Tinggi</span>'
          : (c.isPaid ? '<span class="badge badge-off">Selesai</span>' : '<span class="badge badge-cuti">Rendah</span>');

