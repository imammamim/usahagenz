            <td class="col-right num-tab" style="font-weight:700; color:var(--accent-text);">Rp ${formatRupiah(c.fee15)}</td>
            <td style="color:var(--text-secondary); max-width:190px; overflow:hidden; text-overflow:ellipsis;">${safeCatatan || '<span style="color:var(--text-muted);">—</span>'}</td>
