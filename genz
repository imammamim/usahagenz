    .badge-off { background: var(--off-bg); color: var(--off-text); border-color: var(--off-border); }
    .badge-sage { background: var(--sage-soft); color: var(--sage-text); border-color: var(--border); }
    .st-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    .prog-track { width: 100%; height: 8px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 99px; overflow: hidden; }
    .prog-fill { height: 100%; width: 0%; background: var(--accent); border-radius: 99px; transition: width 0.5s ease; }

    .btn-act {
      display: inline-flex; align-items: center; justify-content: center; height: 32px; padding: 0 11px; font: 600 12px inherit;
      border-radius: 8px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-secondary); cursor: pointer; margin-left: 5px;
    }
    .btn-act:hover { background: var(--bg-hover); color: var(--text-primary); border-color: var(--border-strong); }
    .act-in { background: var(--hadir-bg); color: var(--hadir-text); border-color: var(--hadir-border); }
    .act-del { background: var(--sakit-bg); color: var(--sakit-text); border-color: var(--sakit-border); }

    /* MOBILE CARD LIST */
    .mobile-loan-list { display: none; flex-direction: column; gap: 11px; padding: 12px; }
    .m-loan-card {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: 15px; padding: 14px;
      box-shadow: var(--shadow-xs); display: flex; flex-direction: column; gap: 11px;
    }
    .m-loan-card.is-late { border-color: var(--sakit-border); background: linear-gradient(180deg, var(--sakit-bg) 0%, var(--bg-card) 38%); }
    .m-loan-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .m-loan-identity { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1; }
    .m-loan-name { font-size: 14.5px; font-weight: 800; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .m-loan-meta { font-size: 11.5px; color: var(--text-muted); margin-top: 1px; }
    .m-loan-amounts {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px; background: var(--bg-subtle);
      border: 1px solid var(--border); border-radius: 11px; padding: 9px 11px;
    }
    .m-amt-label { font-size: 11px; color: var(--text-muted); font-weight: 600; }
    .m-amt-val { font-size: 14px; font-weight: 800; font-variant-numeric: tabular-nums; margin-top: 1px; }
    .m-loan-note { font-size: 12px; color: var(--text-secondary); background: var(--bg-subtle); padding: 6px 10px; border-radius: 8px; }
    .m-loan-actions { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 2px; }
    .m-loan-actions .btn-act { margin-left: 0; flex: 1; min-width: 68px; height: 35px; font-size: 12.5px; border-radius: 9px; }
    .m-loan-summary-bar {
      background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 12px; padding: 11px 13px;
      display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; font-weight: 700;
    }

    /* SPLIT LAYOUTS & AI/ADMIN */
    .split-layout, .admin-layout { display: grid; grid-template-columns: 1.35fr 1fr; gap: 18px; align-items: start; }
    .admin-body { padding: 20px; display: flex; flex-direction: column; gap: 15px; }
    .logo-editor-row { display: flex; align-items: center; gap: 14px; padding: 12px 14px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 12px; }
    .logo-preview-lg {
      width: 56px; height: 56px; border-radius: 13px; background: linear-gradient(135deg, #34d399, #059669); color: #07130d;
