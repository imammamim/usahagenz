    function clearAdminAsset(storageKey) {
      localStorage.removeItem(storageKey);
      loadAdminConfig();
      showNotification('Direset', 'Pengaturan dikembalikan ke bawaan.');
    }

    function saveAdminConfig(event) {
      event.preventDefault();
      localStorage.setItem('gz_admin_name', $('adminNameInput').value.trim());
      localStorage.setItem('gz_logo_text', $('logoTextInput').value.trim());
      localStorage.setItem('gz_brand_title', $('brandTitleInput').value.trim());

      const filesToProcess = [];
      if ($('logoImageInput').files[0]) filesToProcess.push({ file: $('logoImageInput').files[0], key: 'gz_logo_image' });
      if ($('adminSignatureInput').files[0]) filesToProcess.push({ file: $('adminSignatureInput').files[0], key: 'gz_admin_signature' });

      if (!filesToProcess.length) {
        loadAdminConfig();
        showNotification('Tersimpan', 'Identitas aplikasi diperbarui.');
        return;
      }

      let done = 0;
      filesToProcess.forEach(item => {
        const reader = new FileReader();
        reader.onload = e => {
          localStorage.setItem(item.key, e.target.result);
          if (++done === filesToProcess.length) {
            loadAdminConfig();
            showNotification('Tersimpan', 'Identitas & gambar berhasil disimpan.');
          }
        };
        reader.readAsDataURL(item.file);
      });
    }

    function changePinAction() {
      const oldPin = $('oldPinInput').value.trim();
      const newPin = $('newPinInput').value.trim();
      if (oldPin !== getCurrentPin()) return showNotification('Gagal', 'PIN Lama tidak sesuai.');
      if (!newPin || newPin.length !== 6 || isNaN(newPin)) return showNotification('Format Salah', 'PIN Baru harus 6 digit angka.');
      localStorage.setItem('gz_pin', newPin);
      google.script.run.sendResetNotification(localStorage.getItem('gz_admin_name') || DEFAULT_CONFIG.adminName);
      $('oldPinInput').value = '';
      $('newPinInput').value = '';
      showNotification('Berhasil', 'PIN keamanan diperbarui & notifikasi email dikirim.');
