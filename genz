        const hasEvidence = item.evidence && item.evidence.length > 0;
        const evBtn = hasEvidence
          ? `<button type="button" class="btn-act" onclick="openEvidenceModal('${evJson}', '${safeNama}')">Bukti (${item.evidence.length})</button>`
