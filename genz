    function formatAIMarkdown(raw) {
      let html = escapeHTML(raw);
      html = html.replace(/^###\s+(.+)$/gm, '<div style="font-weight:800; font-size:14px; margin:8px 0 4px; color:var(--accent-text);">$1</div>');
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/\*([^*\n]+?)\*/g, '<em>$1</em>');
      html = html.replace(/^\s*[\*\-]\s+/gm, '• ');
      html = html.replace(/\n/g, '<br>');
      return html;
    }

    function buildFinancialContextForGemini() {
      const m = computeLoanMetrics_(currentMonthData);
      const feeLunas = (currentMonthData || [])
        .filter(i => classifyLoanItem_(i).isPaid)
        .reduce((s, i) => s + (Number(i.fee15) || 0), 0);

      const aktif = (currentMonthData || [])
        .filter(i => !classifyLoanItem_(i).isPaid)
        .sort((a, b) => classifyLoanItem_(b).total - classifyLoanItem_(a).total)
        .map(d => {
          const c = classifyLoanItem_(d);
          return {
            nama: d.nama,
            bulan: d.bulan,
            tgl: d.tgl,
            pokok: c.pinjaman,
            fee_15_persen: c.fee15,
            total_tagihan: c.total,
            status: d.sisa,
            catatan: d.catatan || ''
          };
        });

      const lunas = (currentMonthData || [])
        .filter(i => classifyLoanItem_(i).isPaid)
        .slice(-15)
        .map(d => {
          const c = classifyLoanItem_(d);
          return {
            nama: d.nama,
            bulan: d.bulan,
            tgl: d.tgl,
            pokok: c.pinjaman,
            total_dibayar: c.total
          };
        });

      const monthsInScope = [...new Set((currentMonthData || []).map(i => i.bulan))];
      const rekapBulanan = monthsInScope.map(bln => {
        const sub = currentMonthData.filter(i => i.bulan === bln);
        const sm = computeLoanMetrics_(sub);
        return {
          bulan: bln,
          transaksi: sub.length,
          modal_keluar: sm.modal,
          jasa_15_persen: sm.fee,
          dana_kembali: sm.kembali,
          piutang_beredar: sm.piutang,
          jatuh_tempo_count: sm.countTempo,
          jatuh_tempo_nominal: sm.overdueNominal
        };
      });

      return {
        tanggal_hari_ini: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }),
        ringkasan: {
          total_transaksi: currentMonthData.length,
          total_modal_keluar: m.modal,
          total_jasa_15_persen: m.fee,
          total_omzet: m.omzet,
          dana_sudah_kembali: m.kembali,
          rasio_pengembalian_persen: m.returnPct,
          piutang_beredar_belum_lunas: m.piutang,
          jumlah_debitur_lunas: m.countLunas,
          jumlah_debitur_aktif_aman: m.countAman,
          jumlah_jatuh_tempo: m.countTempo,
          nominal_jatuh_tempo: m.overdueNominal
        },
        alokasi_jasa: {
          potensi_pengelola_10_persen: Math.round(m.fee * (10 / 15)),
          potensi_sedekah_3_persen: Math.round(m.fee * (3 / 15)),
          potensi_darurat_2_persen: Math.round(m.fee * (2 / 15)),
          realisasi_pengelola_dari_lunas: Math.round(feeLunas * (10 / 15)),
          realisasi_sedekah_dari_lunas: Math.round(feeLunas * (3 / 15)),
          realisasi_darurat_dari_lunas: Math.round(feeLunas * (2 / 15))
        },
        rekap_per_bulan: rekapBulanan,
        debitur_aktif_belum_lunas: aktif,
        debitur_lunas_terbaru: lunas
      };
    }

    function buildLocalFallbackReply(question, periodLabel) {
      const m = computeLoanMetrics_(currentMonthData);
      if (!currentMonthData.length) {
        return `Belum ada transaksi pada periode <strong>${escapeHTML(periodLabel)}</strong>.`;
      }

      const q = String(question || '').toLowerCase();

      const matchedDebtor = currentMonthData.find(d => q.includes(String(d.nama || '').toLowerCase()) && String(d.nama || '').trim().length >= 3);
      if (matchedDebtor) {
        const c = classifyLoanItem_(matchedDebtor);
        return `<strong>Detail Debitur ${escapeHTML(matchedDebtor.nama)} (${escapeHTML(matchedDebtor.bulan)}):</strong><br>• Status: <strong>${escapeHTML(matchedDebtor.sisa)}</strong> (Tgl Pinjam: ${escapeHTML(matchedDebtor.tgl)})<br>• Pokok Pinjaman: <strong>Rp ${formatRupiah(c.pinjaman)}</strong><br>• Jasa 15%: <strong>Rp ${formatRupiah(c.fee15)}</strong><br>• Total Kewajiban: <strong>Rp ${formatRupiah(c.total)}</strong>`;
      }

      if (q.includes('terbesar') || q.includes('konsentrasi')) {
        const top3 = [...currentMonthData]
          .filter(i => !classifyLoanItem_(i).isPaid)
          .sort((a, b) => classifyLoanItem_(b).total - classifyLoanItem_(a).total)
          .slice(0, 3);
        if (!top3.length) return `Seluruh pinjaman pada periode <strong>${escapeHTML(periodLabel)}</strong> sudah berstatus Lunas.`;
        const lines = top3.map((d, idx) => `${idx + 1}. <strong>${escapeHTML(d.nama)}</strong> — Tagihan Rp ${formatRupiah(classifyLoanItem_(d).total)} (${escapeHTML(d.sisa)})`);
        return `<strong>3 Debitur Aktif Terbesar (${escapeHTML(periodLabel)}):</strong><br>${lines.join('<br>')}`;
      }

      if (q.includes('bagi hasil') || q.includes('sedekah') || q.includes('pengelola') || q.includes('darurat')) {
        return `<strong>Proyeksi Alokasi Jasa 15% (${escapeHTML(periodLabel)}):</strong><br>• Total Jasa (15%): <strong>Rp ${formatRupiah(m.fee)}</strong><br>• Pengelola (10%): <strong>Rp ${formatRupiah(m.fee * (10 / 15))}</strong><br>• Sedekah (3%): <strong>Rp ${formatRupiah(m.fee * (3 / 15))}</strong><br>• Dana Darurat (2%): <strong>Rp ${formatRupiah(m.fee * (2 / 15))}</strong>`;
      }

      if (q.includes('plafon') || q.includes('batas') || q.includes('aman')) {
        const safeCap = Math.max(0, Math.round((m.kembali - m.overdueNominal) * 0.7));
        return `<strong>Estimasi Plafon Pinjaman Baru (${escapeHTML(periodLabel)}):</strong><br>• Dana Kembali (Lunas): <strong>Rp ${formatRupiah(m.kembali)}</strong><br>• Dana Tertahan Jatuh Tempo: <strong>Rp ${formatRupiah(m.overdueNominal)}</strong><br>• Batas Aman Penyaluran Baru (70% likuiditas bersih): <strong>Rp ${formatRupiah(safeCap)}</strong>`;
      }

      return `<strong>Audit Ringkas (${escapeHTML(periodLabel)}):</strong><br>• Total <strong>${currentMonthData.length}</strong> transaksi dengan modal keluar <strong>Rp ${formatRupiah(m.modal)}</strong>.<br>• Dana kembali: <strong>Rp ${formatRupiah(m.kembali)}</strong> (${m.countLunas} lunas, rasio ${m.returnPct}%).<br>• Piutang beredar: <strong>Rp ${formatRupiah(m.piutang)}</strong> (${m.countAman} aman, ${m.countTempo} jatuh tempo senilai Rp ${formatRupiah(m.overdueNominal)}).`;
    }

    function generateAIResponse(question) {
      const historyBox = $('aiChatHistory');
      const selected = $('monthFilter').value;
      const periodLabel = selected === 'ALL' ? 'Semua Bulan' : `Bulan ${selected}`;
      const loadId = 'ai-msg-' + Date.now();

      historyBox.insertAdjacentHTML('beforeend', `
        <div class="ai-msg user">${escapeHTML(question)}</div>
        <div id="${loadId}" class="ai-msg bot" style="color:var(--text-muted);">Menganalisis data keuangan (${escapeHTML(periodLabel)})...</div>
      `);
      historyBox.scrollTop = historyBox.scrollHeight;
      setAILoadingState(true);

      const historySnapshot = [...aiConversationHistory];

      google.script.run
        .withSuccessHandler(res => {
          setAILoadingState(false);
          const el = $(loadId);
          if (!el) return;
          el.style.color = 'var(--text-primary)';

          if (res && res.success && res.answer) {
            aiConversationHistory.push({ role: 'user', text: question });
            aiConversationHistory.push({ role: 'model', text: res.answer });
            if (aiConversationHistory.length > 10) aiConversationHistory = aiConversationHistory.slice(-10);

            const copyBtn = `<div style="margin-top:8px; display:flex; justify-content:flex-end;"><button type="button" class="btn btn-ghost btn-xs" style="height:26px; font-size:11px;" onclick="copyAITextResponse('${encodeURIComponent(res.answer)}')">Salin Jawaban</button></div>`;
            el.innerHTML = formatAIMarkdown(res.answer) + copyBtn;
          } else {
            const fallbackHtml = buildLocalFallbackReply(question, periodLabel);
            const reason = (res && res.message) ? res.message : 'Menggunakan analisis lokal.';
            el.innerHTML = `${fallbackHtml}<div style="margin-top:7px; padding-top:6px; border-top:1px solid var(--border); font-size:11.5px; color:var(--izin-text);">Info Sistem: ${escapeHTML(reason)}</div>`;
          }
          historyBox.scrollTop = historyBox.scrollHeight;
        })
        .withFailureHandler(err => {
          setAILoadingState(false);
          const el = $(loadId);
          if (el) {
            el.style.color = 'var(--text-primary)';
            el.innerHTML = `${buildLocalFallbackReply(question, periodLabel)}<div style="margin-top:7px; font-size:11.5px; color:var(--sakit-text);">Koneksi server terputus: ${escapeHTML(err && err.message ? err.message : 'Gagal terhubung')}</div>`;
          }
        })
        .askGeminiFinanceAI(question, periodLabel, buildFinancialContextForGemini(), historySnapshot);
    }

    /* KUITANSI & PNG */
    function openReceipt(itemStr) {
      const item = JSON.parse(decodeURIComponent(itemStr));
      const c = classifyLoanItem_(item);
      const adminName = localStorage.getItem('gz_admin_name') || DEFAULT_CONFIG.adminName;
      const adminSignature = localStorage.getItem('gz_admin_signature') || DEFAULT_CONFIG.adminSignature;
      const brandTitle = localStorage.getItem('gz_brand_title') || DEFAULT_CONFIG.brandTitle;

      if (originalReceiptHTML && !$('rcptNama')) {
        $('receiptContent').innerHTML = originalReceiptHTML;
        loadAdminConfig();
      }

      $('rcptNama').textContent = item.nama;
      $('rcptBulan').textContent = item.bulan;
      $('rcptTgl').textContent = item.tgl;
      $('rcptCatatan').textContent = item.catatan || '-';
      $('rcptNominalPinjaman').textContent = 'Rp ' + formatRupiah(c.pinjaman);
      $('rcptFee').textContent = 'Rp ' + formatRupiah(c.fee15);
      $('rcptTotalTagihan').textContent = 'Rp ' + formatRupiah(c.total);
      $('rcptNoRef').textContent = `REF: #${String(item.no).padStart(3, '0')}/${String(item.bulan).substring(0, 3).toUpperCase()}`;
      $('rcptPrintTime').textContent = 'Dicetak: ' + new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
      $('rcptAdminName').textContent = adminName;
      $('receiptBrandTitle').textContent = brandTitle;
      $('rcptSignatureContainer').innerHTML = `<img src="${adminSignature || defaultSignatureSVG}" alt="Tanda Tangan" style="max-height:46px; max-width:140px; object-fit:contain;">`;
      openModalById('receiptModal');
    }

    function closeReceiptModal() {
      closeModalById('receiptModal');
      setTimeout(() => {
        if (originalReceiptHTML) { $('receiptContent').innerHTML = originalReceiptHTML; loadAdminConfig(); }
      }, 200);
    }

    function downloadReceiptPNG() {
      const canvas = document.createElement('canvas');
      const scale = 2;
      canvas.width = 1100 * scale;
      canvas.height = 1320 * scale;
      const ctx = canvas.getContext('2d');
      ctx.scale(scale, scale);

      const margin = 60, innerX = margin + 45, innerW = 1100 - (margin * 2) - 90;
      ctx.fillStyle = '#e4efe7'; ctx.fillRect(0, 0, 1100, 1320);
      ctx.fillStyle = '#ffffff'; ctx.strokeStyle = '#c5dccb'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.roundRect(margin, margin, 1100 - margin * 2, 1320 - margin * 2, 24); ctx.fill(); ctx.stroke();

      const logoImage = localStorage.getItem('gz_logo_image') || DEFAULT_CONFIG.logoImage;
      const logoText = localStorage.getItem('gz_logo_text') || DEFAULT_CONFIG.logoText;
      const brandTitle = localStorage.getItem('gz_brand_title') || DEFAULT_CONFIG.brandTitle;
      const yStart = margin + 50;

      const proceed = () => renderReceiptCanvasBody(canvas, ctx, yStart, innerX, innerW, brandTitle);
      if (logoImage) {
        const img = new Image();
        img.onload = () => { ctx.drawImage(img, innerX, yStart, 64, 64); proceed(); };
        img.onerror = () => { drawCanvasMonogram(ctx, innerX, yStart, logoText); proceed(); };
        img.src = logoImage;
      } else {
        drawCanvasMonogram(ctx, innerX, yStart, logoText);
        proceed();
      }
    }

    function drawCanvasMonogram(ctx, x, y, text) {
      ctx.fillStyle = '#10231b'; ctx.beginPath(); ctx.roundRect(x, y, 64, 64, 14); ctx.fill();
      ctx.fillStyle = '#34d399'; ctx.font = '800 24px "Plus Jakarta Sans", sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(text, x + 32, y + 40); ctx.textAlign = 'left';
    }

    function renderReceiptCanvasBody(canvas, ctx, y, innerX, innerW, brandTitle) {
      ctx.fillStyle = '#112218'; ctx.font = '800 28px "Plus Jakarta Sans", sans-serif'; ctx.fillText(brandTitle, innerX + 82, y + 28);
      ctx.fillStyle = '#047857'; ctx.font = '700 14px "Plus Jakarta Sans", sans-serif'; ctx.fillText('BUKTI TRANSAKSI RESMI', innerX + 82, y + 52);

      ctx.textAlign = 'right';
      ctx.fillStyle = '#547160'; ctx.font = '700 16px "Plus Jakarta Sans", sans-serif'; ctx.fillText($('rcptNoRef').textContent, innerX + innerW, y + 28);
      ctx.font = '500 13px "Plus Jakarta Sans", sans-serif'; ctx.fillText($('rcptPrintTime').textContent, innerX + innerW, y + 50);
      ctx.textAlign = 'left';

      y += 95;
      ctx.fillStyle = '#e8f8f0'; ctx.strokeStyle = '#a7f3d0'; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.roundRect(innerX, y, innerW, 46, 12); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#047857'; ctx.font = '700 15px "Plus Jakarta Sans", sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('KUITANSI BUKTI PINJAMAN & JASA LAYANAN (15%)', innerX + innerW / 2, y + 28); ctx.textAlign = 'left';

      y += 70;
      [['Nama Peminjam', $('rcptNama').textContent], ['Bulan Periode', $('rcptBulan').textContent], ['Tanggal Transaksi', $('rcptTgl').textContent], ['Catatan', $('rcptCatatan').textContent]].forEach(([lbl, val]) => {
        ctx.fillStyle = '#edf5ef'; ctx.beginPath(); ctx.roundRect(innerX, y, innerW, 48, 11); ctx.fill();
        ctx.fillStyle = '#547160'; ctx.font = '600 16px "Plus Jakarta Sans", sans-serif'; ctx.fillText(lbl, innerX + 18, y + 30);
        ctx.textAlign = 'right'; ctx.fillStyle = '#112218'; ctx.font = '700 16px "Plus Jakarta Sans", sans-serif'; ctx.fillText(val, innerX + innerW - 18, y + 30);
        ctx.textAlign = 'left'; y += 58;
      });

      y += 12;
      ctx.fillStyle = '#10231b'; ctx.beginPath(); ctx.roundRect(innerX, y, innerW, 180, 18); ctx.fill();

      let iy = y + 40;
      ctx.fillStyle = '#96b3a3'; ctx.font = '600 16px "Plus Jakarta Sans", sans-serif'; ctx.fillText('Pokok Pinjaman', innerX + 26, iy);
      ctx.textAlign = 'right'; ctx.fillStyle = '#ffffff'; ctx.font = '700 19px "Plus Jakarta Sans", sans-serif'; ctx.fillText($('rcptNominalPinjaman').textContent, innerX + innerW - 26, iy);

      iy += 42; ctx.textAlign = 'left'; ctx.fillStyle = '#96b3a3'; ctx.fillText('Estimasi Jasa (15%)', innerX + 26, iy);
      ctx.textAlign = 'right'; ctx.fillStyle = '#34d399'; ctx.fillText($('rcptFee').textContent, innerX + innerW - 26, iy);

      iy += 24; ctx.strokeStyle = '#284d3d'; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(innerX + 26, iy); ctx.lineTo(innerX + innerW - 26, iy); ctx.stroke();

      iy += 40; ctx.textAlign = 'left'; ctx.fillStyle = '#f2f8f5'; ctx.font = '700 15px "Plus Jakarta Sans", sans-serif'; ctx.fillText('TOTAL KEWAJIBAN', innerX + 26, iy);
      ctx.textAlign = 'right'; ctx.fillStyle = '#ffffff'; ctx.font = '800 26px "Plus Jakarta Sans", sans-serif'; ctx.fillText($('rcptTotalTagihan').textContent, innerX + innerW - 26, iy);

      y += 215; ctx.textAlign = 'left'; ctx.fillStyle = '#547160'; ctx.font = '600 14px "Plus Jakarta Sans", sans-serif'; ctx.fillText('Status Verifikasi Sistem:', innerX, y);
      ctx.fillStyle = '#047857'; ctx.font = '700 15px "Plus Jakarta Sans", sans-serif'; ctx.fillText('● Terhubung & Tervalidasi Aman', innerX, y + 24);

      const adminName = localStorage.getItem('gz_admin_name') || DEFAULT_CONFIG.adminName;
      const sigSource = localStorage.getItem('gz_admin_signature') || defaultSignatureSVG;
      const boxW = 210, boxX = innerX + innerW - boxW, boxY = y - 20;

      ctx.fillStyle = '#edf5ef'; ctx.strokeStyle = '#c5dccb'; ctx.beginPath(); ctx.roundRect(boxX, boxY, boxW, 110, 14); ctx.fill(); ctx.stroke();
      ctx.textAlign = 'center'; ctx.fillStyle = '#547160'; ctx.font = '600 13px "Plus Jakarta Sans", sans-serif'; ctx.fillText('Disetujui Oleh,', boxX + boxW / 2, boxY + 20);

      const nama = $('rcptNama').textContent;
      const img = new Image();
      img.onload = () => { ctx.drawImage(img, boxX + 25, boxY + 24, 160, 52); finalizeReceiptDownload(canvas, ctx, boxX, boxY, boxW, adminName, nama); };
      img.onerror = () => finalizeReceiptDownload(canvas, ctx, boxX, boxY, boxW, adminName, nama);
      img.src = sigSource;
    }

    async function shareReceiptFile() {
      if (!latestReceiptBlob) return;
      try {
        const file = new File([latestReceiptBlob], latestReceiptFileName, { type: 'image/png' });
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: latestReceiptFileName });
        } else {
          showNotification('Info', 'Gunakan tombol Unduh Kuitansi PNG untuk menyimpan gambar.');
        }
      } catch (e) {}
    }

    function finalizeReceiptDownload(canvas, ctx, boxX, boxY, boxW, adminName, nama) {
      ctx.strokeStyle = '#a3c4ad'; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(boxX + 18, boxY + 78); ctx.lineTo(boxX + boxW - 18, boxY + 78); ctx.stroke();
      ctx.fillStyle = '#112218'; ctx.font = '700 14px "Plus Jakarta Sans", sans-serif'; ctx.textAlign = 'center'; ctx.fillText(adminName, boxX + boxW / 2, boxY + 97);

      canvas.toBlob(blob => {
        latestReceiptBlob = blob;
        const url = URL.createObjectURL(blob);
        const safeName = nama.replace(/[^a-zA-Z0-9]/g, '_');
        latestReceiptFileName = `Kuitansi_${safeName}.png`;
        const canShareFiles = Boolean(navigator.canShare && navigator.share);

        $('receiptContent').innerHTML = `
          <div style="text-align:center; padding:24px 12px; display:flex; flex-direction:column; gap:10px; align-items:center;">
            <span class="badge badge-hadir" style="padding:6px 14px; font-size:12.5px;">Kuitansi PNG Siap Diunduh</span>
            <p style="font-size:13px; color:var(--text-secondary);">Simpan bukti transaksi ke penyimpanan perangkat atau bagikan langsung ke WhatsApp.</p>
            <a href="${url}" download="${latestReceiptFileName}" class="btn btn-primary" style="width:100%; max-width:260px; text-decoration:none;">Unduh Kuitansi PNG</a>
            ${canShareFiles ? `<button type="button" class="btn btn-sage" style="width:100%; max-width:260px;" onclick="shareReceiptFile()">Bagikan ke WhatsApp / Galeri</button>` : ''}
          </div>
        `;
      }, 'image/png');
    }

    if ('serviceWorker' in navigator && location.protocol.indexOf('http') === 0) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js').catch(() => {});
      });
    }
  </script>
