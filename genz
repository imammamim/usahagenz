<!DOCTYPE html>
<html lang="id">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>USAHA GEN Z — Enterprise Finance</title>
  <meta name="theme-color" content="#10231b">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="manifest" href="./manifest.json">
  <link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png">
  <link rel="apple-touch-icon" href="./icon-192.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root {
      --bg-app: #e4efe7; --bg-pattern: rgba(16, 185, 129, 0.16);
      --bg-card: #ffffff; --bg-subtle: #edf5ef; --bg-hover: #dcebe0;
      --border: #c5dccb; --border-strong: #a3c4ad;
      --text-primary: #112218; --text-secondary: #2d4738; --text-muted: #547160;
      --accent: #10b981; --accent-hover: #059669; --accent-soft: #d1fae5; --accent-text: #047857; --accent-on-solid: #ffffff;
      --sage: #5f856e; --sage-soft: #d9eadf; --sage-text: #2f543e;
      --sb-bg: #10231b; --sb-surface: #173025; --sb-hover: #204032; --sb-border: #284d3d;
      --sb-text: #f2f8f5; --sb-muted: #96b3a3; --sb-emerald: #34d399; --sb-emerald-hover: #10b981; --sb-emerald-soft: rgba(52, 211, 153, 0.16);
      --sidebar-w: 252px; --sidebar-collapsed-w: 74px;
      --shadow-xs: 0 2px 8px rgba(17, 34, 24, 0.05); --shadow-modal: 0 22px 38px -10px rgba(17, 34, 24, 0.28);
      --hadir-bg: #e8f8f0; --hadir-text: #047857; --hadir-border: #a7f3d0;
      --sakit-bg: #fef2f2; --sakit-text: #b91c1c; --sakit-border: #fecaca;
      --izin-bg: #fffbeb; --izin-text: #b45309; --izin-border: #fde68a;
      --cuti-bg: #ecfdfb; --cuti-text: #0f766e; --cuti-border: #99f6e4;
      --off-bg: #e8f1eb; --off-text: #375243; --off-border: #c7dccf;
    }
    [data-theme="dark"] {
      --bg-app: #09130e; --bg-pattern: rgba(52, 211, 153, 0.09);
      --bg-card: #101e18; --bg-subtle: #162820; --bg-hover: #1e352b;
      --border: #243d32; --border-strong: #335445;
      --text-primary: #f0f7f3; --text-secondary: #cde0d6; --text-muted: #87a394;
      --accent: #10b981; --accent-hover: #34d399; --accent-soft: rgba(16, 185, 129, 0.16); --accent-text: #34d399; --accent-on-solid: #06120c;
      --sage: #7ca18c; --sage-soft: rgba(124, 161, 140, 0.15); --sage-text: #a5c4b2;
      --sb-bg: #070f0b; --sb-surface: #0e1a14; --sb-hover: #16271f; --sb-border: #1e3329;
      --shadow-xs: 0 2px 8px rgba(0, 0, 0, 0.36); --shadow-modal: 0 24px 42px -12px rgba(0, 0, 0, 0.78);
      --hadir-bg: rgba(16, 185, 129, 0.15); --hadir-text: #34d399; --hadir-border: rgba(16, 185, 129, 0.30);
      --sakit-bg: rgba(239, 68, 68, 0.16); --sakit-text: #f87171; --sakit-border: rgba(239, 68, 68, 0.30);
      --izin-bg: rgba(245, 158, 11, 0.15); --izin-text: #fbbf24; --izin-border: rgba(245, 158, 11, 0.30);
      --cuti-bg: rgba(20, 184, 166, 0.15); --cuti-text: #2dd4bf; --cuti-border: rgba(20, 184, 166, 0.30);
      --off-bg: rgba(135, 163, 148, 0.14); --off-text: #cde0d6; --off-border: rgba(135, 163, 148, 0.25);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    html { font-size: 16px; -webkit-text-size-adjust: 100%; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-app);
      background-image:
        radial-gradient(var(--bg-pattern) 1.25px, transparent 1.25px),
        radial-gradient(var(--bg-pattern) 1.25px, var(--bg-app) 1.25px);
      background-size: 28px 28px;
      background-position: 0 0, 14px 14px;
      color: var(--text-primary);
      font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased;
      transition: background-color 0.2s, color 0.2s; overflow-x: hidden;
    }

    /* PIN LOCK & CAT MASCOT */
    .pin-gate {
      position: fixed; inset: 0; background: rgba(10, 22, 16, 0.78); backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px); z-index: 80; display: flex; align-items: center; justify-content: center; padding: 16px;
    }
    .pin-gate.hidden { display: none; }
    .pin-card {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: 22px;
      width: 100%; max-width: 375px; padding: 24px 20px; box-shadow: var(--shadow-modal); text-align: center;
    }
    .cat-box { width: 120px; height: 92px; margin: 0 auto 6px; user-select: none; }
    #cat-head { transform-origin: 80px 68px; transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .cat-pupil-group { transition: transform 0.18s ease-out; }
    .cat-paw { transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .cat-cover #cat-paw-left { transform: translate(13px, -50px) rotate(-10deg); }
    .cat-cover #cat-paw-right { transform: translate(-13px, -50px) rotate(10deg); }
    .cat-success #cat-head { animation: catJump 0.55s ease; }
    .cat-error #cat-head, .pin-dots-error { animation: catShake 0.38s ease; }
    @keyframes catJump { 0%,100% { transform: translateY(0); } 45% { transform: translateY(-9px); } }
    @keyframes catShake { 0%,100% { transform: translateX(0); } 25%,75% { transform: translateX(-6px); } 50% { transform: translateX(6px); } }

    .pin-dots { display: flex; justify-content: center; gap: 12px; margin: 14px 0 8px; }
    .pin-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--bg-subtle); border: 1.5px solid var(--border-strong); transition: all 0.15s; }
    .pin-dot.active { background: var(--accent); border-color: var(--accent); transform: scale(1.15); }
    .pin-dot.error { background: var(--sakit-text); border-color: var(--sakit-text); }
    .pin-dot.success { background: var(--accent); border-color: var(--accent); }
    .pin-err { font-size: 12.5px; font-weight: 700; color: var(--sakit-text); min-height: 18px; margin-bottom: 10px; }
    .pin-keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .pin-key {
      height: 48px; border-radius: 12px; border: 1px solid var(--border); background: var(--bg-subtle);
      color: var(--text-primary); font: 700 18px inherit; cursor: pointer; display: flex; align-items: center; justify-content: center;
    }
    .pin-key:hover { background: var(--bg-hover); }
    .pin-key:active { transform: scale(0.95); }
    .pin-key.reset { background: var(--sakit-bg); color: var(--sakit-text); border-color: var(--sakit-border); font-size: 12px; }

    /* APP SHELL & SIDEBAR */
    .app-shell { display: flex; min-height: 100dvh; }
    .app-shell.locked { opacity: 0; pointer-events: none; }
    .sidebar {
      width: var(--sidebar-w); background: var(--sb-bg); border-right: 1px solid var(--sb-border); color: var(--sb-text);
      display: flex; flex-direction: column; position: fixed; inset: 0 auto 0 0; z-index: 35; transition: width 0.2s, transform 0.25s;
    }
    body.sidebar-collapsed .sidebar { width: var(--sidebar-collapsed-w); }
    .sidebar-header { padding: 16px; display: flex; align-items: center; border-bottom: 1px solid var(--sb-border); }
    .brand { display: flex; align-items: center; gap: 11px; overflow: hidden; }
    .brand-mark {
      width: 38px; height: 38px; border-radius: 10px; background: linear-gradient(135deg, #34d399, #059669);
      color: #07130d; font-weight: 800; font-size: 13px; display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; overflow: hidden; border: 1px solid rgba(52, 211, 153, 0.45);
    }
    .brand-mark img, .logo-preview-lg img, .avatar img, .detail-avatar-lg img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .brand-info { overflow: hidden; white-space: nowrap; }
    .brand-name { font-size: 14.5px; font-weight: 700; color: var(--sb-text); text-overflow: ellipsis; overflow: hidden; }
    .brand-sub { font-size: 11.5px; color: var(--sb-muted); text-overflow: ellipsis; overflow: hidden; }
    body.sidebar-collapsed .brand-info, body.sidebar-collapsed .nav-label, body.sidebar-collapsed .nav-section-title,
    body.sidebar-collapsed .shift-card-detail, body.sidebar-collapsed .btn-cta-text, body.sidebar-collapsed .nav-pill { display: none; }
    body.sidebar-collapsed .sidebar-header { justify-content: center; padding: 16px 10px; }

    .sidebar-body { flex: 1; padding: 14px 12px; display: flex; flex-direction: column; gap: 14px; overflow-y: auto; }
    .btn-cta {
      width: 100%; height: 42px; background: var(--sb-emerald); color: #06140e; border: none; border-radius: 11px;
      font: 700 13.5px inherit; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer;
    }
    .btn-cta:hover { background: var(--sb-emerald-hover); color: #fff; }
    .nav-section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sb-muted); padding: 0 10px 6px; }
    .nav-list { display: flex; flex-direction: column; gap: 4px; }
    .nav-item {
      width: 100%; display: flex; align-items: center; gap: 11px; padding: 10px 12px; border-radius: 10px;
      border: 1px solid transparent; background: transparent; color: #c6dbd0; font: 500 13.5px inherit; text-align: left; cursor: pointer;
    }
    body.sidebar-collapsed .nav-item { justify-content: center; padding: 10px; }
    .nav-item:hover { background: var(--sb-hover); color: #fff; }
    .nav-item.active { background: var(--sb-emerald-soft); color: var(--sb-emerald); border-color: rgba(52, 211, 153, 0.28); font-weight: 600; }
    .nav-item svg { flex-shrink: 0; }
    .nav-pill { margin-left: auto; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 6px; background: rgba(52, 211, 153, 0.16); color: var(--sb-emerald); }

    .shift-box { background: var(--sb-surface); border: 1px solid var(--sb-border); border-radius: 12px; padding: 10px 12px; margin-top: auto; }
    body.sidebar-collapsed .shift-box { padding: 10px; display: flex; justify-content: center; }
    .shift-row { display: flex; align-items: center; gap: 9px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sb-emerald); box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.24); flex-shrink: 0; }
    .shift-title { font-size: 12.5px; font-weight: 700; color: var(--sb-text); }
    .shift-sub { font-size: 11.5px; color: var(--sb-muted); }
    .sidebar-footer { padding: 10px 12px calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--sb-border); display: flex; flex-direction: column; gap: 3px; }
    .spin-icon { animation: spin360 0.8s linear infinite; }
    @keyframes spin360 { to { transform: rotate(360deg); } }

    /* WORKSPACE */
    .main-area { flex: 1; margin-left: var(--sidebar-w); min-width: 0; display: flex; flex-direction: column; transition: margin-left 0.2s; }
    body.sidebar-collapsed .main-area { margin-left: var(--sidebar-collapsed-w); }
    .workspace-header {
      background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border); padding: 14px 28px; display: flex; flex-wrap: wrap;
      align-items: center; justify-content: space-between; gap: 12px; position: sticky; top: 0; z-index: 15;
    }
    [data-theme="dark"] .workspace-header { background: rgba(16, 30, 24, 0.90); }
    .header-left { display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1; }
    .mobile-menu-btn {
      display: none; width: 40px; height: 40px; border-radius: 11px; border: 1px solid var(--border);
      background: var(--bg-card); color: var(--text-primary); align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0;
    }
    .title-wrap { min-width: 0; flex: 1; }
    .page-title { font-size: clamp(17px, 2vw, 19px); font-weight: 800; letter-spacing: -0.015em; line-height: 1.25; }
    .page-subtitle { font-size: 12.5px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .header-controls { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

    .segment-group { display: inline-flex; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 11px; padding: 3px; gap: 3px; }
    .segment-btn {
      border: none; background: transparent; color: var(--text-muted); font: 600 13px inherit; padding: 6px 13px;
      border-radius: 8px; cursor: pointer; white-space: nowrap; flex-shrink: 0;
    }
    .segment-btn:hover:not(.active) { color: var(--text-primary); }
    .segment-btn.active { background: #10231b; color: #34d399; }
    [data-theme="dark"] .segment-btn.active { background: var(--accent); color: #06140e; }

    .field { height: 38px; padding: 0 12px; border: 1px solid var(--border); border-radius: 11px; background: var(--bg-card); color: var(--text-primary); font: 14px inherit; }
    .field:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .search-box { position: relative; display: flex; align-items: center; }
    .search-box svg { position: absolute; left: 11px; color: var(--text-muted); pointer-events: none; }
    .search-input { padding-left: 34px; min-width: 240px; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 38px; padding: 0 14px;
      font: 600 13px inherit; border-radius: 11px; border: 1px solid transparent; cursor: pointer; white-space: nowrap;
    }
    .btn:active { transform: scale(0.97); }
    .btn-primary { background: var(--accent); color: var(--accent-on-solid); }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-sage { background: #10231b; color: #34d399; border-color: #284d3d; }
    .btn-sage:hover { background: #173327; color: #6ee7b7; }
    .btn-danger-ghost { background: var(--sakit-bg); color: var(--sakit-text); border-color: var(--sakit-border); }
    .btn-ghost { background: var(--bg-card); color: var(--text-secondary); border-color: var(--border); }
    .btn-ghost:hover { background: var(--bg-hover); color: var(--text-primary); border-color: var(--border-strong); }
    .btn-xs { height: 32px; padding: 0 11px; font-size: 12.5px; border-radius: 9px; }
    .btn:disabled { opacity: 0.65; cursor: not-allowed; }

    .workspace-body { padding: 22px 28px 64px; max-width: 1440px; width: 100%; margin: 0 auto; }

    /* KPI & HERO */
    .kpi-grid { display: grid; grid-template-columns: 1.65fr repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 20px; }
    .kpi-grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 20px; }
    .kpi-grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 20px; }
    .kpi-card {
      background: var(--bg-card); border: 1px solid var(--border); border-top: 3px solid var(--accent); border-radius: 16px;
      padding: 16px 18px; box-shadow: var(--shadow-xs); cursor: pointer; display: flex; flex-direction: column; justify-content: space-between;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .kpi-card:nth-child(even) { border-top-color: var(--sage); }
    .kpi-card:hover { transform: translateY(-2px); border-color: var(--accent); }
    .kpi-card.no-click { cursor: default; }
    .kpi-card.no-click:hover { transform: none; }

    .kpi-card.hero-omzet {
      background: linear-gradient(135deg, #10231b 0%, #1a3b2d 60%, #112d21 100%);
      border: 1px solid #284d3d; border-top: 3px solid #34d399; color: #f2f8f5;
    }
    .kpi-card.hero-omzet .kpi-label { color: #a5c4b2; }
    .kpi-card.hero-omzet .kpi-num { color: #ffffff; }
    .kpi-card.hero-omzet .mini-pills { border-top-color: rgba(255, 255, 255, 0.12); }
    .hero-ratio-wrap { margin-top: 10px; }
    .hero-ratio-meta { display: flex; justify-content: space-between; font-size: 11px; color: #96b3a3; margin-bottom: 5px; font-weight: 600; }
    .hero-ratio-track { width: 100%; height: 6px; background: rgba(255, 255, 255, 0.14); border-radius: 99px; overflow: hidden; }
    .hero-ratio-fill { height: 100%; background: linear-gradient(90deg, #34d399, #10b981); border-radius: 99px; transition: width 0.4s ease; }

    .kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 8px; }
    .kpi-label { font-size: 12.5px; font-weight: 600; color: var(--text-muted); }
    .kpi-chip { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 7px; border: 1px solid transparent; white-space: nowrap; }
    .kpi-num { font-size: clamp(19px, 2vw, 24px); font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -0.015em; }
    .kpi-sub { font-size: 11.5px; color: var(--text-muted); margin-top: 6px; }
    .mini-pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 11px; padding-top: 10px; border-top: 1px solid var(--border); }
    .m-pill { font-size: 11.5px; font-weight: 600; padding: 4px 9px; border-radius: 8px; background: var(--off-bg); color: var(--off-text); border: 1px solid var(--off-border); cursor: pointer; text-align: center; }
    .p-hadir { background: var(--hadir-bg); color: var(--hadir-text); border-color: var(--hadir-border); }
    .p-sakit { background: var(--sakit-bg); color: var(--sakit-text); border-color: var(--sakit-border); }
    .p-izin { background: var(--izin-bg); color: var(--izin-text); border-color: var(--izin-border); }
    .p-cuti { background: var(--cuti-bg); color: var(--cuti-text); border-color: var(--cuti-border); }

    /* URGENT OVERDUE BANNER */
    .urgent-banner {
      background: var(--bg-card); border: 1px solid var(--sakit-border); border-left: 4px solid var(--sakit-text);
      border-radius: 15px; padding: 14px 16px; margin-bottom: 18px; box-shadow: var(--shadow-xs);
      display: none; flex-direction: column; gap: 10px;
    }
    .urgent-banner.show { display: flex; }
    .urgent-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .urgent-title { font-size: 13.5px; font-weight: 800; color: var(--sakit-text); display: flex; align-items: center; gap: 7px; }
    .urgent-list { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: none; }
    .urgent-list::-webkit-scrollbar { display: none; }
    .urgent-chip-card {
      flex: 0 0 auto; min-width: 235px; background: var(--sakit-bg); border: 1px solid var(--sakit-border);
      border-radius: 12px; padding: 10px 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
    }

    /* PANELS & TABLES */
    .panel { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-xs); overflow: hidden; margin-bottom: 20px; }
    .panel-head { padding: 15px 20px; border-bottom: 1px solid var(--border); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
    .panel-title-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    .panel-title { font-size: 15.5px; font-weight: 700; }
    .period-pill { font-size: 12px; font-weight: 600; color: var(--accent-text); background: var(--accent-soft); border: 1px solid var(--border); padding: 3px 10px; border-radius: 999px; }

    .table-scroll { overflow-x: auto; max-height: 600px; -webkit-overflow-scrolling: touch; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th {
      background: var(--bg-subtle); color: var(--text-muted); font-size: 11.5px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.04em; padding: 12px 15px; border-bottom: 1px solid var(--border); white-space: nowrap; position: sticky; top: 0; z-index: 4;
    }
    td { padding: 12px 15px; border-bottom: 1px solid var(--border); font-size: 13.5px; vertical-align: middle; white-space: nowrap; }
    tfoot td { background: var(--bg-subtle); font-weight: 700; border-top: 1px solid var(--border-strong); border-bottom: none; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background-color: var(--bg-hover); }
    tbody tr.row-late td { background-color: var(--sakit-bg) !important; }
    .col-center { text-align: center; font-variant-numeric: tabular-nums; }
    .col-right { text-align: right; font-variant-numeric: tabular-nums; }
    .num-tab { font-variant-numeric: tabular-nums; }

    .member-cell { display: flex; align-items: center; gap: 10px; min-width: 170px; }
    .avatar {
      width: 35px; height: 35px; border-radius: 10px; background: #10231b; border: 1px solid var(--border-strong); color: #34d399;
      font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; cursor: pointer;
    }
    .member-link { background: none; border: none; padding: 0; font: 700 13.5px inherit; color: var(--text-primary); cursor: pointer; text-align: left; }
    .member-link:hover { color: var(--accent-text); text-decoration: underline; }

