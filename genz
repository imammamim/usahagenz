      $('currentYearFooter').textContent = new Date().getFullYear();
      if (localStorage.getItem('gz_sidebar_collapsed') === '1') document.body.classList.add('sidebar-collapsed');
      applyTheme(localStorage.getItem('theme') || 'light');

      if (sessionStorage.getItem('gz_authenticated') === 'true') {
        $('pinModal').classList.add('hidden');
        $('mainAppWrapper').classList.remove('locked');
