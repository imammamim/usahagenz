  <script>
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbzB6OIvRR413JUHQcxHOUkj8vD5OUohcMO-iPBNLjxFhwsAyIhn9ubJkvJnhDq15_ii/exec";

    if (typeof window.google === "undefined" || !window.google.script) {
      function createGasRunner(successCb, failureCb) {
        return new Proxy({}, {
          get(_, prop) {
            if (prop === "withSuccessHandler") return (fn) => createGasRunner(fn, failureCb);
            if (prop === "withFailureHandler") return (fn) => createGasRunner(successCb, fn);
            return (...args) => {
              if (!GAS_API_URL || GAS_API_URL.indexOf("http") !== 0) {
                const err = new Error("URL Web App Apps Script belum diisi pada GAS_API_URL di index.html.");
                if (failureCb) failureCb(err);
                return;
              }
              fetch(GAS_API_URL, {
                method: "POST",
                headers: { "Content-Type": "text/plain;charset=utf-8" },
                body: JSON.stringify({ action: prop, args: args })
              })
              .then(res => res.json())
              .then(res => {
                if (res.status === "ok") {
                  if (successCb) successCb(res.data);
                } else if (failureCb) {
                  failureCb(new Error(res.message || "Gagal memproses permintaan"));
                }
              })
              .catch(err => { if (failureCb) failureCb(err); });
            };
          }
        });
      }
      window.google = { script: { get run() { return createGasRunner(null, null); } } };
    }

    const $ = id => document.getElementById(id);
    const escapeHTML = str => !str ? '' : String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    const formatRupiah = num => new Intl.NumberFormat('id-ID').format(Math.round(Number(num) || 0));

    const DEFAULT_CONFIG = { adminName: 'Imam Mohammed', brandTitle: 'USAHA GEN Z', logoText: 'GZ', logoImage: '', adminSignature: '' };
    const MONTH_MAP = { Jan:'01', Feb:'02', Mar:'03', Apr:'04', Mei:'05', Jun:'06', Jul:'07', Agu:'08', Sep:'09', Okt:'10', Nov:'11', Des:'12' };
    const defaultSignatureSVG = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 80'><path d='M40 65 C60 60, 80 20, 100 45 C110 58, 120 40, 150 42 M70 45 C50 42, 35 50, 45 55 C55 60, 65 30, 95 15' stroke='%23065f46' stroke-width='4' fill='none' stroke-linecap='round'/></svg>";

    let globalLoans = [];
    let globalMonths = [];
    let currentMonthData = [];
    let currentStatusFilter = 'ALL';
    let chartInstance = null;
    let isChartVisible = true;
    let deleteTarget = null;
    let enteredPin = '';
    let originalReceiptHTML = '';
    let notifTimeout = null;
    let latestReceiptBlob = null;
    let latestReceiptFileName = 'Kuitansi.png';

    function classifyLoanItem_(item) {
      const pinjaman = Number(item.pinjaman) || 0;
      const fee15 = Number(item.fee15) || 0;
      const total = pinjaman + fee15;
      const st = String(item.sisa || '').toLowerCase();
      const isPaid = st.indexOf('lunas') !== -1;
      const isOverdue = !isPaid && st.indexOf('jatuh tempo') !== -1;
      return { pinjaman, fee15, total, isPaid, isOverdue };
    }

    function computeLoanMetrics_(items) {
      let modal = 0, fee = 0, kembali = 0, piutang = 0, overdueNominal = 0;
      let countLunas = 0, countAman = 0, countTempo = 0;
      const overdueItems = [];

      (items || []).forEach(item => {
        const c = classifyLoanItem_(item);
        modal += c.pinjaman;
        fee += c.fee15;
        if (c.isPaid) {
          kembali += c.total;
          countLunas++;
        } else {
          piutang += c.total;
          if (c.isOverdue) {
            countTempo++;
            overdueNominal += c.total;
            overdueItems.push(item);
          } else {
            countAman++;
          }
        }
      });

      const omzet = modal + fee;
      const returnPct = omzet > 0 ? Math.min(100, Math.round((kembali / omzet) * 100)) : 0;
      return { modal, fee, kembali, piutang, omzet, returnPct, overdueNominal, overdueItems, countLunas, countAman, countTempo };
    }

    function showNotification(title, desc) {
      if (!$('notification')) return;
      $('notifTitle').textContent = title;
      $('notifDesc').textContent = desc;
      clearTimeout(notifTimeout);
      $('notification').classList.add('show');
      notifTimeout = setTimeout(() => $('notification').classList.remove('show'), 3200);
    }

    function applyTheme(theme) {
      const isDark = theme === 'dark';
      if (isDark) document.documentElement.setAttribute('data-theme', 'dark');
      else document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('theme', theme);
      $('iconSun').style.display = isDark ? 'block' : 'none';
      $('iconMoon').style.display = isDark ? 'none' : 'block';
      $('btnThemeText').textContent = isDark ? 'Mode Terang' : 'Mode Gelap';
      if (globalLoans.length) initChart();
    }

    function toggleTheme() {
      applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    }

    function toggleSidebarCollapse() {
      document.body.classList.toggle('sidebar-collapsed');
      localStorage.setItem('gz_sidebar_collapsed', document.body.classList.contains('sidebar-collapsed') ? '1' : '0');
    }

    function openMobileSidebar() {
      $('sidebar').classList.add('mobile-open');
      $('sidebarOverlay').classList.add('show');
    }

    function closeMobileSidebar() {
      $('sidebar').classList.remove('mobile-open');
      $('sidebarOverlay').classList.remove('show');
    }

    function switchView(view) {
      closeMobileSidebar();
      const views = {
        dashboard: ['Dashboard Pinjaman', 'Monitoring modal keluar, piutang beredar, dan jatuh tempo'],
        keuntungan: ['Keuntungan & Sedekah', 'Rincian alokasi jasa 15% (Pengelola 10%, Sedekah 3%, Darurat 2%)'],
        ai: ['Asisten AI Finansial', 'Audit likuiditas, konsultasi Gemini AI, dan pengingat jatuh tempo'],
        admin: ['Pengaturan Admin', 'Kelola identitas aplikasi, tanda tangan kuitansi, API Key, dan PIN']
      };
      Object.keys(views).forEach(v => {
        if ($(`section-${v}`)) $(`section-${v}`).style.display = v === view ? 'block' : 'none';
        if ($(`nav-${v}`)) $(`nav-${v}`).classList.toggle('active', v === view);
        if ($(`mb-nav-${v}`)) $(`mb-nav-${v}`).classList.toggle('active', v === view);
      });
      if (views[view]) {
        $('headerTitle').textContent = views[view][0];
        $('headerSubtitle').textContent = views[view][1];
      }
      if (view === 'ai') {
        refreshAIInsights();
        checkGeminiConnectionStatus();
      }
    }

    /* PIN & CAT MASCOT */
    function getCurrentPin() { return localStorage.getItem('gz_pin') || '200299'; }

    function updateCatMascotState(state, pinLength = 0) {
      const catBox = $('catMascotBox');
      const catHead = $('cat-head');
      const catPupils = $('cat-pupils');
      const eyesOpen = $('cat-eyes-open');
      const eyesHappy = $('cat-eyes-happy');
      const browLeft = $('cat-brow-left');
      const browRight = $('cat-brow-right');
      const mouth = $('cat-mouth');
      const dotsContainer = $('pinDotsContainer');
      if (!catBox) return;

      catBox.classList.remove('cat-cover', 'cat-success', 'cat-error');
      dotsContainer.classList.remove('pin-dots-error');

      if (state === 'typing') {
        catBox.classList.add('cat-cover');
        eyesOpen.style.display = 'block';
        eyesHappy.style.display = 'none';
        catPupils.style.transform = `translate(${(pinLength - 3) * 1.4}px, 2px)`;
        catHead.style.transform = `rotate(${(pinLength - 3) * 1.5}deg)`;
        mouth.setAttribute('d', 'M 76 83 Q 80 88 84 83 Q 80 80 76 83');
      } else if (state === 'success') {
        catBox.classList.add('cat-success');
        eyesOpen.style.display = 'none';
        eyesHappy.style.display = 'block';
        catHead.style.transform = 'rotate(0deg)';
        mouth.setAttribute('d', 'M 69 81 Q 80 95 91 81');
      } else if (state === 'error') {
        catBox.classList.add('cat-error');
        dotsContainer.classList.add('pin-dots-error');
        eyesOpen.style.display = 'block';
        eyesHappy.style.display = 'none';
        catPupils.style.transform = 'translate(0px, 0px)';
        catHead.style.transform = 'rotate(0deg)';
        browLeft.setAttribute('d', 'M 52 45 L 70 52');
        browRight.setAttribute('d', 'M 108 45 L 90 52');
        mouth.setAttribute('d', 'M 71 87 Q 75.5 82 80 86 Q 84.5 82 89 87');
      } else {
        eyesOpen.style.display = 'block';
        eyesHappy.style.display = 'none';
        catPupils.style.transform = 'translate(0px, 0px)';
        catHead.style.transform = 'rotate(0deg)';
        browLeft.setAttribute('d', 'M 52 49 Q 62 46 70 49');
        browRight.setAttribute('d', 'M 90 49 Q 98 46 108 49');
        mouth.setAttribute('d', 'M 71 82 Q 75.5 87 80 82 Q 84.5 87 89 82');
      }
    }

    function updatePinDots(status = 'normal') {
      for (let i = 0; i < 6; i++) {
        const dot = $(`dot-${i}`);
        dot.className = 'pin-dot';
        if (status === 'error') dot.classList.add('error');
        else if (status === 'success') dot.classList.add('success');
        else if (i < enteredPin.length) dot.classList.add('active');
      }
    }

    function pressPin(num) {
      if (enteredPin.length < 6) {
        enteredPin += num;
        updatePinDots();
        updateCatMascotState('typing', enteredPin.length);
        if (enteredPin.length === 6) setTimeout(verifyPin, 150);
      }
    }

    function deletePin() {
      if (enteredPin.length > 0) {
        enteredPin = enteredPin.slice(0, -1);
        updatePinDots();
        $('pinErrorMsg').textContent = '';
        updateCatMascotState(enteredPin.length === 0 ? 'idle' : 'typing', enteredPin.length);
      }
    }

    function clearPin() {
      enteredPin = '';
      updatePinDots();
      $('pinErrorMsg').textContent = '';
      updateCatMascotState('idle', 0);
    }

    function verifyPin() {
      if (enteredPin === getCurrentPin()) {
        sessionStorage.setItem('gz_authenticated', 'true');
        updatePinDots('success');
        updateCatMascotState('success', 6);
        setTimeout(() => {
          $('pinModal').classList.add('hidden');
          $('mainAppWrapper').classList.remove('locked');
          showNotification('Akses Diberikan', 'Selamat datang di Usaha Gen Z');
        }, 420);
      } else {
        $('pinErrorMsg').textContent = 'PIN Salah! Silakan ulangi';
        updatePinDots('error');
        updateCatMascotState('error', 0);
        setTimeout(() => {
          enteredPin = '';
          updatePinDots('normal');
          updateCatMascotState('idle', 0);
          $('pinErrorMsg').textContent = '';
        }, 720);
      }
    }

    document.addEventListener('keydown', e => {
      const pinModal = $('pinModal');
      if (pinModal && !pinModal.classList.contains('hidden')) {
        if (e.key >= '0' && e.key <= '9') { e.preventDefault(); pressPin(e.key); }
        else if (e.key === 'Backspace') { e.preventDefault(); deletePin(); }
        else if (e.key === 'Escape') { e.preventDefault(); clearPin(); }
      }
    });

