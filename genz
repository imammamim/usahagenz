    function refreshAIInsights() {
      const data = currentMonthData;
      const remBox = $('aiReminderList');
      const selected = $('monthFilter') ? $('monthFilter').value : 'ALL';
      if ($('aiActivePeriodPill')) {
        $('aiActivePeriodPill').textContent = selected === 'ALL' ? 'Semua Bulan' : `Bulan ${selected}`;
      }

      if (!data || !data.length) {
        $('aiHealthScore').textContent = '0 / 100';
        $('aiHealthLabel').textContent = 'Kosong';
        $('aiHealthBar').style.width = '0%';
        $('aiOverdueCount').textContent = '0 Debitur';
        $('aiOverdueTotal').textContent = 'Potensi Dana Tertahan: Rp 0';
        $('aiNetProfit').textContent = 'Rp 0';
        $('aiTopDebtor').textContent = 'Pinjaman Terbesar: -';
        remBox.innerHTML = '<div class="empty-msg">Belum ada transaksi pada periode ini.</div>';
        return;
      }

      const m = computeLoanMetrics_(data);
      const totalTagihanAll = m.omzet;
      const lunasRatio = totalTagihanAll > 0 ? (m.kembali / totalTagihanAll) : 0;
      const score = Math.max(0, Math.min(100, Math.round((lunasRatio * 85) + 15 - ((m.countTempo / data.length) * 35))));
      const topItem = [...data].sort((a, b) => (Number(b.pinjaman) || 0) - (Number(a.pinjaman) || 0))[0];

      $('aiHealthScore').textContent = `${score} / 100`;
      $('aiHealthLabel').textContent = score >= 75 ? 'Sangat Sehat' : (score >= 45 ? 'Pantau' : 'Risiko Tinggi');
      $('aiHealthBar').style.width = `${score}%`;
      $('aiOverdueCount').textContent = `${m.countTempo} Debitur`;
      $('aiOverdueTotal').textContent = `Potensi Dana Tertahan: Rp ${formatRupiah(m.overdueNominal)}`;
      $('aiNetProfit').textContent = `Rp ${formatRupiah(m.fee * (10 / 15))}`;
      $('aiTopDebtor').textContent = `Terbesar: ${topItem.nama} (Rp ${formatRupiah(topItem.pinjaman)})`;

      if (!m.overdueItems.length) {
        remBox.innerHTML = '<div class="empty-msg">Tidak ada pinjaman jatuh tempo pada periode ini.</div>';
      } else {
        const sorted = [...m.overdueItems].sort((a, b) => ((Number(b.pinjaman) || 0) + (Number(b.fee15) || 0)) - ((Number(a.pinjaman) || 0) + (Number(a.fee15) || 0)));
        remBox.innerHTML = sorted.map((item, idx) => {
          const totalKewajiban = (Number(item.pinjaman) || 0) + (Number(item.fee15) || 0);
          return `
