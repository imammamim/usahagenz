    function loadData() {
      $('syncIcon')?.classList.add('spin-icon');
      google.script.run
        .withSuccessHandler(data => {
          $('syncIcon')?.classList.remove('spin-icon');
          globalLoans = data.loans || [];
          globalMonths = data.monthNames || [];
          $('syncStatusText').textContent = `${globalLoans.length} Transaksi Aktif`;
          populateMonthDropdowns();
          initChart();
          updateDashboard();
          renderKSTable();
          updateSedekahWidget();
          refreshAIInsights();
        })
        .withFailureHandler(() => {
          $('syncIcon')?.classList.remove('spin-icon');
          $('syncStatusText').textContent = 'Gagal terhubung ke server';
          showNotification('Koneksi Gagal', 'Tidak dapat mengambil data Spreadsheet.');
        })
        .getAppData();
