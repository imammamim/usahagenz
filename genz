    function populateMonthDropdowns() {
      const filterSelect = $('monthFilter');
      const prevSelected = filterSelect.value || 'ALL';
      const inputSelect = $('inputBulan');
      const editSelect = $('editBulan');

      filterSelect.innerHTML = '<option value="ALL">Semua Bulan</option>';
      inputSelect.innerHTML = '';
      if (editSelect) editSelect.innerHTML = '';

      globalMonths.forEach(bulan => {
        const opt = `<option value="${escapeHTML(bulan)}">${escapeHTML(bulan)}</option>`;
        filterSelect.innerHTML += opt;
        inputSelect.innerHTML += opt;
        if (editSelect) editSelect.innerHTML += opt;
      });

      if (prevSelected !== 'ALL' && globalMonths.includes(prevSelected)) filterSelect.value = prevSelected;
      if (globalMonths.length > 0) inputSelect.value = globalMonths[globalMonths.length - 1];
    }

    function onMonthChange() {
      const selected = $('monthFilter').value;
      showNotification('Periode Diubah', selected === 'ALL' ? 'Menampilkan semua bulan' : `Periode: Bulan ${selected}`);
      updateDashboard();
      refreshAIInsights();
    }

    function updateDashboard() {
      const selectedMonth = $('monthFilter').value;
      currentMonthData = selectedMonth === 'ALL' ? globalLoans : globalLoans.filter(i => i.bulan === selectedMonth);

      $('printMonthLabel').textContent = `Periode Laporan: ${selectedMonth === 'ALL' ? 'Semua Bulan' : 'Bulan ' + selectedMonth}`;
      $('printDate').textContent = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

      const m = computeLoanMetrics_(currentMonthData);

      $('grandTotal').textContent = `Rp ${formatRupiah(m.omzet)}`;
      $('heroReturnPct').textContent = `${m.returnPct}% Kembali`;
      $('heroReturnBar').style.width = `${m.returnPct}%`;

      $('totalPinjaman').textContent = `Rp ${formatRupiah(m.modal)}`;
      $('totalKembali').textContent = `Rp ${formatRupiah(m.kembali)}`;
      $('totalPiutang').textContent = `Rp ${formatRupiah(m.piutang)}`;
      $('riskHighVal').textContent = `${m.countTempo} Debitur`;
      $('riskHighNominal').textContent = `Rp ${formatRupiah(m.overdueNominal)}`;
      $('riskLowSummary').textContent = `Aman: ${m.countAman} Debitur`;

      $('pillCountLunas').textContent = `Lunas: ${m.countLunas}`;
      $('pillCountAman').textContent = `Aman: ${m.countAman}`;
      $('pillCountTempo').textContent = `Jatuh Tempo: ${m.countTempo}`;
