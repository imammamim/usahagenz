    function buildWAMessage_(item) {
      const brandTitle = localStorage.getItem('gz_brand_title') || DEFAULT_CONFIG.brandTitle;
      const total = (Number(item.pinjaman) || 0) + (Number(item.fee15) || 0);
      return `Halo Kak ${item.nama}, izin menginformasikan dari ${brandTitle} terkait pinjaman periode ${item.bulan} (Tgl ${item.tgl}) sebesar Rp ${formatRupiah(item.pinjaman)} + jasa Rp ${formatRupiah(item.fee15)} (Total Rp ${formatRupiah(total)}) telah memasuki masa jatuh tempo. Mohon konfirmasinya jika sudah melakukan pembayaran. Terima kasih.`;
    }

    function renderUrgentOverdueBanner(overdueItems) {
      const banner = $('urgentOverdueBanner');
      const listEl = $('urgentOverdueList');
      if (!banner || !listEl) return;

      if (!overdueItems || !overdueItems.length) {
        banner.classList.remove('show');
        listEl.innerHTML = '';
        return;
      }

      banner.classList.add('show');
      $('urgentBadgeCount').textContent = `${overdueItems.length} Debitur`;

      listEl.innerHTML = overdueItems.map(item => {
        const total = (Number(item.pinjaman) || 0) + (Number(item.fee15) || 0);
        const waMsg = encodeURIComponent(buildWAMessage_(item));
        return `
          <div class="urgent-chip-card">
            <div style="min-width:0;">
              <div style="font-size:13px; font-weight:800; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:130px;">${escapeHTML(item.nama)}</div>
