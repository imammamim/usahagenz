                  <span class="avatar">${escapeHTML(getInitials(item.nama))}</span>
                  <div style="min-width:0;">
                    <div class="m-loan-name">${safeNama}</div>
                    <div class="m-loan-meta">${escapeHTML(item.bulan)} • ${escapeHTML(item.tgl)}</div>
                  </div>
                </div>
                <div>${statusBadge}</div>
              </div>
              <div class="m-loan-amounts" onclick="openBorrowerDetail('${itemJson}')">
                <div><div class="m-amt-label">Pokok Pinjaman</div><div class="m-amt-val">Rp ${formatRupiah(c.pinjaman)}</div></div>
                <div style="text-align:right;"><div class="m-amt-label">Jasa (15%)</div><div class="m-amt-val" style="color:var(--accent-text);">Rp ${formatRupiah(c.fee15)}</div></div>
