            <div style="display:flex; gap:5px;">
              <button type="button" class="btn btn-ghost btn-xs" style="padding:0 8px;" onclick="copyWAReminder('${waMsg}', '${escapeHTML(item.nama)}')">WA</button>
              <button type="button" class="btn btn-primary btn-xs" style="padding:0 9px;" onclick="markPaid('${escapeHTML(item.bulan)}', '${escapeHTML(String(item.no))}', this)">Lunas</button>
