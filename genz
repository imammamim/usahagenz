    function showCardDetails(type, title) {
      const filtered = currentMonthData.filter(item => {
        const c = classifyLoanItem_(item);
        if (type === 'LUNAS') return c.isPaid;
        if (type === 'PIUTANG') return !c.isPaid;
        if (type === 'AMAN') return !c.isOverdue && !c.isPaid;
        if (type === 'JATUH_TEMPO') return c.isOverdue;
        return true;
      });

      const nominalLabel = type === 'MODAL' ? 'Pokok Pinjaman' : 'Total (Pokok + Jasa)';
      const tbody = $('detailModalBody');
      tbody.innerHTML = '';
      let total = 0;

      if (!filtered.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="empty-msg">Tidak ada rincian data untuk kategori ini.</td></tr>';
      } else {
