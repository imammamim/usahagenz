          <div class="m-loan-summary-bar">
            <span style="color:var(--text-muted);">Total (${dataArray.length} Data)</span>
            <span class="num-tab" style="color:var(--accent-text);">Rp ${formatRupiah(sumPinjaman + sumFee)}</span>
          </div>
        `);
      }

      tfoot.innerHTML = `
        <tr>
          <td colspan="6" class="col-right" style="font-size:11.5px; text-transform:uppercase; color:var(--text-muted);">Total Ditampilkan (${dataArray.length} Data):</td>
          <td class="col-right num-tab">Rp ${formatRupiah(sumPinjaman)}</td>
